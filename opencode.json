{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma-personal": {
      "enabled": true
    },
    "youtrack": {
      "enabled": true
    }
  },
  "formatter": {
    "biome": {
      "command": ["pnpm", "exec", "biome", "check", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".css",
        ".md",
        ".mdx"
      ]
    }
  }
}
